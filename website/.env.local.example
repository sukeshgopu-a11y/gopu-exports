NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ADMIN_EMAIL=admin@gopuexports.com
EMAIL_FROM=GOPU Exports <onboarding@resend.dev>
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRED=false
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.05
# Legacy fallback still supported by code if already configured:
RESEND_FROM_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=

# NEXT_PUBLIC_SUPABASE_ANON_KEY is safe to expose in browser code.
# It is protected by Supabase Row Level Security policies.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security.
# Dashboard CRUD uses Supabase Auth sessions plus RLS. Public ingestion and
# maintenance require this server key. Never put it in Client Components,
# browser code, or NEXT_PUBLIC_* variables.

# Required for public submissions, analytics and shared rate limits after the audit migration.
# Never expose this key via NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=server-only-key
# Vercel deployments automatically use x-vercel-forwarded-for when VERCEL=1.
# On other hosts, set only a header your ingress overwrites.
# Without a known ingress, requests use one conservative shared bucket.
TRUSTED_CLIENT_IP_HEADER=

# Required only when scheduling GET /api/admin/retry-emails. Use a long random secret.
CRON_SECRET=
