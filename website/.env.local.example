NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ADMIN_EMAIL=admin@gopuexports.com
RESEND_FROM_EMAIL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_X_URL=

# NEXT_PUBLIC_SUPABASE_ANON_KEY is safe to expose in browser code.
# It is protected by Supabase Row Level Security policies.
#
# SUPABASE_SERVICE_ROLE_KEY bypasses Row Level Security.
# This app does not require it for normal dashboard CRUD because admin routes use
# Supabase Auth sessions plus RLS. If you add server-only maintenance scripts,
# never use this key in Client Components, browser code, or NEXT_PUBLIC_* variables.
